-- DROP TABLE IF EXISTS public.ordini;

CREATE TABLE IF NOT EXISTS public.ordini
(
    "id_Ordine" integer NOT NULL DEFAULT nextval('"ordini_id_Ordine_seq"'::regclass),
    email character varying COLLATE pg_catalog."default",
    data date NOT NULL,
    totale real NOT NULL,
    stato boolean NOT NULL,
    CONSTRAINT ordini_pkey PRIMARY KEY ("id_Ordine"),
    CONSTRAINT email FOREIGN KEY (email)
        REFERENCES public.utenti (email) MATCH SIMPLE
        ON UPDATE NO ACTION
        ON DELETE NO ACTION
)

TABLESPACE pg_default;

ALTER TABLE IF EXISTS public.ordini
    OWNER to postgres;

